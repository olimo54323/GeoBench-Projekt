<UserControl x:Class="GeoBench.Wpf.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GeoBench.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BenchmarkViewModel}"
             d:DesignWidth="900" d:DesignHeight="600">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Scenariusz" Style="{StaticResource SectionHeader}" />
            <ComboBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" HorizontalAlignment="Left" MinWidth="420">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Id, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Name, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Warianty" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Variants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BenchmarkVariantItemViewModel}">
                                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="32,0,0,0">
                    <TextBlock Text="Pomiar" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pomiary:" Width="90" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Repetitions, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                        <TextBlock Text="Rozgrzewki:" Margin="16,0,0,0" Width="80" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Warmups, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                    </StackPanel>
                    <CheckBox Margin="0,6,0,0" IsChecked="{Binding Diagnostics}"
                              Content="Przebieg diagnostyczny z planem zapytania (W1, W2; poza pomiarem)" />
                    <CheckBox Margin="0,4,0,0" IsChecked="{Binding SaveResults}"
                              Content="Zapisz pary do tabeli wyników (np. budynki_stref) w bazie wariantu" />
                    <CheckBox Margin="0,4,0,0" IsChecked="{Binding AllowCountMismatch}"
                              Content="Dopuść różne liczności tabel w bazach (wyniki nieporównywalne)" />

                    <TextBlock Text="Wzorzec z QGIS (CSV: id_a, id_b[, miara])" Margin="0,10,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="Usuń" Command="{Binding ClearReferenceCommand}" />
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Wybierz…" Command="{Binding BrowseReferenceCommand}" />
                        <TextBox Text="{Binding ReferencePath, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="Bez wzorca wyniki porównywane są z pierwszym udanym wariantem. Czas zawiera odczyt wszystkich par do aplikacji." />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                <Button Content="Uruchom pomiar" Command="{Binding RunCommand}" Padding="12,2" />
                <Button Content="Otwórz katalog wyników" Command="{Binding OpenResultsDirectoryCommand}" Margin="8,0,0,0" Padding="8,2" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray" Text="{Binding ResultsDirectory}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,6" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                            <Setter Property="Foreground" Value="DarkRed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Wariant" Binding="{Binding Variant}" />
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" />
                <DataGridTextColumn Header="Mediana [ms]" Binding="{Binding Median}" />
                <DataGridTextColumn Header="p95 [ms]" Binding="{Binding P95}" />
                <DataGridTextColumn Header="Min – max [ms]" Binding="{Binding MinMax}" />
                <DataGridTextColumn Header="Fazy (mediany) [ms]" Binding="{Binding Phases}" />
                <DataGridTextColumn Header="Pary" Binding="{Binding Pairs}" />
                <DataGridTextColumn Header="SHA-256" Binding="{Binding Hash}" FontFamily="Consolas" />
                <DataGridTextColumn Header="Zgodność" Binding="{Binding Validation}" />
                <DataGridTextColumn Header="Uwagi" Binding="{Binding Notes}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
