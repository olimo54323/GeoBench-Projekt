<Window x:Class="GeoBench.Wpf.Views.FeatureInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GeoBench.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FeatureInfoViewModel}"
        Title="Informacje o obiektach" Width="520" Height="620" MinWidth="360" MinHeight="300"
        ShowInTaskbar="False">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyExecuted" />
    </Window.CommandBindings>

    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Location}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8" />
        <ProgressBar DockPanel.Dock="Top" Height="4" IsIndeterminate="True" Margin="0,0,0,8"
                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />

        <TreeView x:Name="Tree" ItemsSource="{Binding Tables}" Grid.IsSharedSizeScope="True"
                  SelectedItemChanged="OnSelectedItemChanged" PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:FeatureTableNodeViewModel}" ItemsSource="{Binding Objects}">
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Padding="0,2">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Kopiuj tabelę" Command="{Binding CopyTableCommand}" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </HierarchicalDataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type vm:FeatureObjectNodeViewModel}" ItemsSource="{Binding Fields}">
                    <TextBlock Text="{Binding Header}" Padding="0,2">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Kopiuj obiekt" Command="{Binding CopyObjectCommand}" />
                                <MenuItem Header="Kopiuj geometrię (WKT, EPSG:2180)" Command="{Binding CopyWktCommand}"
                                          IsEnabled="{Binding HasGeometry}" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type vm:FeatureFieldNodeViewModel}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldName" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Kopiuj pole i wartość" Command="{Binding CopyFieldCommand}" />
                                <MenuItem Header="Kopiuj wartość" Command="{Binding CopyValueCommand}" />
                                <Separator />
                                <MenuItem Header="Kopiuj obiekt" Command="{Binding CopyObjectCommand}" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <TextBlock Text="{Binding Name}" Foreground="#555555" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" MaxWidth="320" />
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</Window>
