<UserControl x:Class="GeoBench.Wpf.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GeoBench.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ImportViewModel}"
             d:DesignWidth="800" d:DesignHeight="300">
    <StackPanel Margin="12">
        <TextBlock Text="Plan ogólny gminy (GML, APP 2.0)" Style="{StaticResource SectionHeader}" />

        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Wybierz…" Command="{Binding BrowseCommand}" />
            <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBlock Text="Bazy docelowe" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />
        <CheckBox Content="SQL Server" IsChecked="{Binding ToSqlServer}" />
        <CheckBox Content="PostgreSQL + PostGIS" IsChecked="{Binding ToPostgres}" Margin="0,4,0,0" />

        <CheckBox Margin="0,16,0,0" IsChecked="{Binding DaneBadawcze}"
                  Content="Dane badawcze (plan nieobowiązujący, użyty wyłącznie do badania)" />

        <TextBlock Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="Ponowny import tego samego aktu zastępuje poprzedni. Po zapisie powstaje indeks przestrzenny stref. Import nie jest pomiarem." />

        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Content="Importuj" Command="{Binding ImportCommand}" />

        <TextBlock Text="Podsumowanie" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />
        <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48"
                 BorderThickness="0" Background="Transparent" />
    </StackPanel>
</UserControl>
