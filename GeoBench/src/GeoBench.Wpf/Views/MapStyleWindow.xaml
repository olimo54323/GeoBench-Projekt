<Window x:Class="GeoBench.Wpf.Views.MapStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GeoBench.Wpf.ViewModels"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MapStyleViewModel}"
        Title="Styl mapy" Width="760" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Przywróć wszystkie domyślne" Command="{Binding ResetAllCommand}" />
            <Button DockPanel.Dock="Right" Content="Anuluj" IsCancel="True" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Zapisz" IsDefault="True" Click="OnSaveClick" />
        </DockPanel>

        <TabControl>
            <TabItem Header="Kolory">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="ItemsList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StyleItemViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="14" Background="{Binding Preview}" BorderBrush="{Binding OutlinePreview}" BorderThickness="1.5" />
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" Width="240" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" DataContext="{Binding SelectedItem}">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" TextWrapping="Wrap" />

                        <TextBlock Text="Kolor wypełnienia" Margin="0,8,0,4" />
                        <xctk:ColorPicker SelectedColor="{Binding FillColor}" UsingAlphaChannel="False" Width="180" HorizontalAlignment="Left" />

                        <TextBlock Text="Krycie wypełnienia (%)" Margin="0,12,0,4" />
                        <DockPanel>
                            <xctk:DoubleUpDown DockPanel.Dock="Right" Width="70" Minimum="0" Maximum="100" Increment="5" FormatString="0"
                                               Value="{Binding FillOpacityPercent}" Margin="8,0,0,0" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding FillOpacityPercent}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="Kolor obrysu" Margin="0,12,0,4" />
                        <xctk:ColorPicker SelectedColor="{Binding OutlineColor}" UsingAlphaChannel="False" Width="180" HorizontalAlignment="Left" />

                        <TextBlock Text="Grubość obrysu (px)" Margin="0,12,0,4" />
                        <xctk:DoubleUpDown Width="70" HorizontalAlignment="Left" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0"
                                           Value="{Binding OutlineWidth}" />

                        <Button Content="Przywróć domyślne dla tej pozycji" HorizontalAlignment="Left" Margin="0,16,0,0"
                                Command="{Binding DataContext.ResetSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Wyświetlanie">
                <StackPanel Margin="8">
                    <TextBlock Text="Plan ogólny gminy" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Krycie całej warstwy stref nad podkładem (%)" Margin="0,0,0,4" />
                    <DockPanel Width="400" HorizontalAlignment="Left">
                        <xctk:DoubleUpDown DockPanel.Dock="Right" Width="70" Minimum="0" Maximum="100" Increment="5" FormatString="0"
                                           Value="{Binding PlanOpacityPercent}" Margin="8,0,0,0" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding PlanOpacityPercent}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="Pobieranie danych dla okna mapy" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Działki i budynki widoczne, gdy okno ma najwyżej (km):" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <xctk:DoubleUpDown Grid.Column="1" Width="90" Minimum="0.1" Maximum="100" Increment="0.5" FormatString="0.0"
                                           Value="{Binding MaxDetailWindowKm}" />

                        <TextBlock Grid.Row="1" Text="Najwięcej działek naraz:" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <xctk:IntegerUpDown Grid.Row="1" Grid.Column="1" Width="90" Minimum="100" Maximum="500000" Increment="1000"
                                            Value="{Binding MaxDzialki}" Margin="0,8,0,0" />

                        <TextBlock Grid.Row="2" Text="Najwięcej budynków naraz:" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <xctk:IntegerUpDown Grid.Row="2" Grid.Column="1" Width="90" Minimum="100" Maximum="500000" Increment="1000"
                                            Value="{Binding MaxBudynki}" Margin="0,8,0,0" />

                        <TextBlock Grid.Row="3" Text="Najwięcej stref naraz:" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <xctk:IntegerUpDown Grid.Row="3" Grid.Column="1" Width="90" Minimum="100" Maximum="100000" Increment="500"
                                            Value="{Binding MaxStrefy}" Margin="0,8,0,0" />
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="Mapę można zawsze przesuwać i przybliżać; po zmianie widoku dane są pobierane dla nowego okna. Duże limity spowalniają rysowanie (np. 20 000 poligonów to już kilkadziesiąt MB w pamięci)." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
