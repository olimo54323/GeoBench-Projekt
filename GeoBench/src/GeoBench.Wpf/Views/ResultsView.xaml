<UserControl x:Class="GeoBench.Wpf.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GeoBench.Wpf.ViewModels"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ResultsViewModel}"
             d:DesignWidth="900" d:DesignHeight="600">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Raporty z katalogu results -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Raporty" Style="{StaticResource SectionHeader}" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button Content="Odśwież listę" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" Padding="8,2" />
                <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" FontSize="11"
                           Text="{Binding ResultsRoot, StringFormat=Katalog: {0}}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Reports}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportItemViewModel}">
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}" Foreground="Gray" TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" Margin="4,0" />

        <!-- Wykres -->
        <DockPanel Grid.Column="2">
            <!-- WrapPanel: przy wąskim oknie przyciski przechodzą do drugiego wiersza zamiast znikać -->
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="Wykres:" VerticalAlignment="Center" Margin="0,0,6,4" />
                <ComboBox ItemsSource="{Binding ChartKinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Name" MinWidth="220" Margin="0,0,12,4" />
                <CheckBox Content="Skala logarytmiczna" IsChecked="{Binding LogScale}" IsEnabled="{Binding CanUseLogScale}"
                          VerticalAlignment="Center" Margin="0,0,12,4" />
                <Button Content="Eksportuj (PNG/SVG)…" Command="{Binding ExportCommand}" Margin="0,0,8,4" Padding="8,2" />
                <Button Content="Otwórz katalog raportu" Command="{Binding OpenReportFolderCommand}" Margin="0,0,8,4" Padding="8,2" />
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedKind.Hint}" Foreground="Gray" Margin="0,0,0,4" />
            <scottplot:WpfPlot x:Name="Chart" />
        </DockPanel>
    </Grid>
</UserControl>
